<Window x:Class="DrivingSchool.Desktop.WorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Автошкола" Width="1120" Height="690" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen" AutomationProperties.AutomationId="WorkspaceWindow">
  <DockPanel LastChildFill="True">
    <Border DockPanel.Dock="Top" Background="{StaticResource Header}" Padding="26,16">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Выйти" Command="{Binding Logout}"
                AutomationProperties.AutomationId="LogoutButton" Margin="14,0,0,0" Background="#FFF1E5"/>
        <TextBlock DockPanel.Dock="Right" Text="{Binding SessionCaption}" Foreground="#F4DAC8"
                   VerticalAlignment="Center" AutomationProperties.AutomationId="SessionCaption"/>
        <StackPanel Orientation="Horizontal">
          <Grid Width="26" Height="26" Margin="0,0,11,0">
            <Path Data="M 3,24 L 9,2 M 23,24 L 17,2" Stroke="{StaticResource Copper}" StrokeThickness="2"/>
            <Path Data="M 13,3 L 13,8 M 13,11 L 13,16 M 13,19 L 13,24" Stroke="#FFEDD8" StrokeThickness="2"/>
          </Grid>
          <TextBlock Text="Автошкола" Foreground="#FFF6EC" FontWeight="SemiBold" FontSize="25"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="#EADBCF" Padding="26,8" MinHeight="35">
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource Ink}"
                 AutomationProperties.AutomationId="WorkspaceMessage"/>
    </Border>
    <TabControl AutomationProperties.AutomationId="WorkspaceTabs" SelectedIndex="{Binding Tab}"
                Margin="24,0,24,17" BorderThickness="0" TabStripPlacement="Top" Padding="0" Background="{StaticResource Canvas}">
      <TabControl.Resources>
        <Style TargetType="TabItem" BasedOn="{StaticResource SectionTab}"/>
      </TabControl.Resources>
      <TabItem Header="Занятия" AutomationProperties.AutomationId="LessonsTab">
        <DockPanel Margin="20,17,20,14">
          <TextBlock DockPanel.Dock="Top" Text="{Binding LessonHeading}" FontWeight="SemiBold" FontSize="23" Margin="0,0,0,12"/>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Поиск" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,4"/>
            <TextBox AutomationProperties.AutomationId="LessonSearchInput" Width="234" Margin="0,0,8,4" ToolTip="Номер, упражнение, адрес, ученик или телефон"
                     AutomationProperties.Name="Поиск по занятиям" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}">
              <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding RefreshLessons}"/></TextBox.InputBindings>
            </TextBox>
            <Button AutomationProperties.AutomationId="RefreshLessonsButton" Content="Найти" Command="{Binding RefreshLessons}" Margin="0,0,8,4"/>
            <Button Content="Новое занятие" Command="{Binding NewLesson}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,4"
                    Visibility="{Binding IsStaff, Converter={StaticResource VisibleWhen}}" AutomationProperties.AutomationId="NewLessonButton"/>
          </WrapPanel>
          <ListBox DockPanel.Dock="Top" AutomationProperties.AutomationId="LessonStatusFilter"
                   AutomationProperties.Name="Фильтр по статусу" Margin="0,0,0,12" Padding="0"
                   BorderThickness="0" Background="{StaticResource Canvas}"
                   ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Pill" CornerRadius="9" BorderThickness="1" BorderBrush="{StaticResource Line}"
                              Padding="11,6" Margin="0,0,6,4" Background="#FBF2E9">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Pill" Property="Background" Value="#EFDFD2"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="Pill" Property="Background" Value="{StaticResource Accent}"/>
                          <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource Accent}"/>
                          <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
          <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button AutomationProperties.AutomationId="DetailsButton" Content="Карточка" Command="{Binding Details}" Margin="0,0,8,4"/>
            <Button AutomationProperties.AutomationId="EditLessonButton" Content="Редактировать" Command="{Binding EditLesson}" Margin="0,0,8,4"
                    Visibility="{Binding IsStaff, Converter={StaticResource VisibleWhen}}"/>
            <Button AutomationProperties.AutomationId="TransitionButton" Content="Сменить статус" Command="{Binding Transition}" Margin="0,0,8,4"/>
            <StackPanel Orientation="Horizontal" Margin="8,0,0,4"
                        Visibility="{Binding IsStaff, Converter={StaticResource VisibleWhen}}">
              <TextBlock Text="Выгрузить" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Button AutomationProperties.AutomationId="ExportCSVButton" Content="CSV" Command="{Binding Export}" CommandParameter="csv" Margin="0,0,4,0"/>
              <Button AutomationProperties.AutomationId="ExportJSONButton" Content="JSON" Command="{Binding Export}" CommandParameter="json" Margin="0,0,4,0"/>
              <Button AutomationProperties.AutomationId="ExportXMLButton" Content="XML" Command="{Binding Export}" CommandParameter="xml"/>
            </StackPanel>
          </WrapPanel>
          <TextBlock DockPanel.Dock="Bottom" Text="{Binding LessonCount}" Foreground="{StaticResource Muted}" Margin="0,10,0,0"
                     AutomationProperties.AutomationId="LessonCount"/>
          <Grid>
            <DataGrid ItemsSource="{Binding Lessons}" SelectedItem="{Binding SelectedLesson}"
                      AutomationProperties.AutomationId="LessonsGrid">
              <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding Lesson.Id}" Width="48"/>
                <DataGridTextColumn Header="Упражнение" Binding="{Binding Lesson.Title}" Width="2*" MinWidth="132"/>
                <DataGridTextColumn Header="Ученик" Binding="{Binding Lesson.Student}" Width="1.3*" MinWidth="105"/>
                <DataGridTemplateColumn Header="Статус" SortMemberPath="Status" Width="138">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border HorizontalAlignment="Left" VerticalAlignment="Center" Margin="7,0,0,0"
                              CornerRadius="9" Padding="8,3">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="#ECE5DF"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Status}" Value="Подтверждено"><Setter Property="Background" Value="#F5DEB9"/></DataTrigger>
                              <DataTrigger Binding="{Binding Status}" Value="Проведено"><Setter Property="Background" Value="#DCE6D7"/></DataTrigger>
                              <DataTrigger Binding="{Binding Status}" Value="Перенесено"><Setter Property="Background" Value="#EDDCCC"/></DataTrigger>
                              <DataTrigger Binding="{Binding Status}" Value="Пропущено"><Setter Property="Background" Value="#F4DCDC"/></DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Status}" Foreground="#39261D" FontSize="12" FontWeight="SemiBold"/>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Инструктор" Binding="{Binding Lesson.Instructor, TargetNullValue=—}" Width="120"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Amount}" Width="115"/>
                <DataGridTextColumn Header="Начало" Binding="{Binding Schedule}" Width="115"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{Binding EmptyLessons}" IsHitTestVisible="False" Foreground="{StaticResource Muted}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
          </Grid>
        </DockPanel>
      </TabItem>
      <TabItem Header="Ученики" AutomationProperties.AutomationId="StudentsTab"
               Visibility="{Binding IsStaff, Converter={StaticResource VisibleWhen}}">
        <DockPanel Margin="20,17,20,14">
          <TextBlock DockPanel.Dock="Top" Text="Справочник учеников" FontWeight="SemiBold" FontSize="23" Margin="0,0,0,12"/>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button AutomationProperties.AutomationId="NewStudentButton" Content="Добавить" Command="{Binding NewStudent}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,4"/>
            <Button AutomationProperties.AutomationId="EditStudentButton" Content="Редактировать" Command="{Binding EditStudent}" Margin="0,0,8,4"/>
            <Button AutomationProperties.AutomationId="ImportButton" Content="Импорт CSV" Command="{Binding Import}" Margin="0,0,8,4"/>
            <Button AutomationProperties.AutomationId="RefreshStudentsButton" Content="Обновить" Command="{Binding RefreshStudents}" Margin="0,0,8,4"/>
          </WrapPanel>
          <TextBlock DockPanel.Dock="Bottom" Text="CSV в UTF-8. Заголовок Name,Phone,Email. Поддерживаются запятая и точка с запятой."
                     Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
          <DataGrid AutomationProperties.AutomationId="StudentsGrid" ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="60"/>
              <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="1.5*"/>
              <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="*"/>
              <DataGridTextColumn Header="Эл. почта" Binding="{Binding Email}" Width="1.5*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="Статистика" AutomationProperties.AutomationId="StatisticsTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="20,17,20,14">
            <DockPanel Margin="0,0,0,14">
              <Button AutomationProperties.AutomationId="RefreshStatisticsButton" DockPanel.Dock="Right" Content="Обновить" Command="{Binding RefreshStatistics}"/>
              <TextBlock Text="Статистика занятий" FontWeight="SemiBold" FontSize="23" VerticalAlignment="Center"/>
            </DockPanel>
            <WrapPanel Margin="0,0,0,12">
              <TextBlock Margin="0,0,23,7" Text="{Binding Statistics.Total, StringFormat='Всего {0}'}"/>
              <TextBlock Margin="0,0,23,7" Text="{Binding Statistics.Open, StringFormat='В работе {0}'}"/>
              <TextBlock Margin="0,0,23,7" Text="{Binding Statistics.Completed, StringFormat='Проведено {0}'}"/>
              <TextBlock Margin="0,0,23,7" Text="{Binding Statistics.Rescheduled, StringFormat='Перенесено {0}'}"/>
              <TextBlock Margin="0,0,23,7" Text="{Binding Statistics.Missed, StringFormat='Пропущено {0}'}"/>
            </WrapPanel>
            <WrapPanel Margin="0,0,0,14">
              <TextBlock Margin="0,0,23,7" Text="{Binding Statistics.TotalAmount, StringFormat='Сумма всех занятий {0:N2} ₽'}"/>
              <TextBlock Margin="0,0,23,7" Text="{Binding Statistics.CompletedAmount, StringFormat='Сумма проведённых {0:N2} ₽'}"/>
              <TextBlock Margin="0,0,23,7" Text="{Binding AverageDays, StringFormat='Средний срок до проведения {0}'}"/>
            </WrapPanel>
            <DataGrid AutomationProperties.AutomationId="StatisticsGrid" ItemsSource="{Binding Statuses}" MaxWidth="560" HorizontalAlignment="Left" Width="435">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Статус" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Занятия" Binding="{Binding Count}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Пользователи" AutomationProperties.AutomationId="UsersTab"
               Visibility="{Binding IsAdmin, Converter={StaticResource VisibleWhen}}">
        <DockPanel Margin="20,17,20,14">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <Button AutomationProperties.AutomationId="RefreshUsersButton" DockPanel.Dock="Right" Content="Обновить" Command="{Binding RefreshUsers}"/>
            <TextBlock Text="Пользователи автошколы" FontWeight="SemiBold" FontSize="23" VerticalAlignment="Center"/>
          </DockPanel>
          <DataGrid AutomationProperties.AutomationId="UsersGrid" ItemsSource="{Binding Users}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Имя" Binding="{Binding User.DisplayName}" Width="*"/>
              <DataGridTextColumn Header="Логин" Binding="{Binding User.Login}" Width="*"/>
              <DataGridTextColumn Header="Роль" Binding="{Binding RoleName}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>

